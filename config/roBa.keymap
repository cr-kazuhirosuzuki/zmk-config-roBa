            #binding-cells = <2>;
            tapping-term-ms = <200>;
            bindings = <&SelectLineNext_LW>, <&MoveLineNext_ALW>;
            flavor = "tap-preferred";
        };

        PointerLayer_A: PointerLayer_A {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&mo 15>, <&tog 15>;
