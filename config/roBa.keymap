        PointerLayer_LW: PointerLayer_LW {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&mo 16>, <&tog 16>;
        };

    };
};

