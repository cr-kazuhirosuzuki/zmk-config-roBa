    };
};




/ {
    macros {
        BLE_Profile_0: BLE_Profile_0 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&out OUT_BLE>, <&bt BT_SEL 0>;
        };

        BLE_Profile_1: BLE_Profile_1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&out OUT_BLE>, <&bt BT_SEL 1>;
        };

        BLE_Profile_2: BLE_Profile_2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&out OUT_BLE>, <&bt BT_SEL 2>;
        };

        BLE_Profile_3: BLE_Profile_3 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&out OUT_BLE>, <&bt BT_SEL 3>;
        };

        BLE_Profile_4: BLE_Profile_4 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&out OUT_BLE>, <&bt BT_SEL 4>;
        };


        MoveLinePrev_ALW: MoveLinePrev_ALW {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp UP>;
        };

        MoveLineNext_ALW: MoveLineNext_ALW {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp DOWN>;
        };

        HT_MoveSelectLinePrev_A: HT_MoveSelectLinePrev_A {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            bindings = <&SelectLinePrev_A>, <&MoveLinePrev_ALW>;
            flavor = "tap-preferred";
