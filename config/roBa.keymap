        HT_MoveSelectLineNext_A: HT_MoveSelectLineNext_A {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            bindings = <&SelectLineNext_A>, <&MoveLineNext_ALW>;
            flavor = "tap-preferred";
        };

        HT_MoveSelectLinePrev_LW: HT_MoveSelectLinePrev_LW {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            bindings = <&SelectLinePrev_LW>, <&MoveLinePrev_ALW>;
            flavor = "tap-preferred";
